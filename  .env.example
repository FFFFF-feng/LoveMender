
# 阿里云DashScope API密钥（替换为你自己的）
DASHSCOPE_API_KEY=your_api_key_here
# 全局配置常量
# Chroma向量数据库的持久化目录
CHROMA_DB_DIR=./chroma_rag_db
# 日志目录
LOG_DIR=./logs

# RAG参数
# 文本切片的参数
CHUNK_SIZE=512
# 文本切片的重叠长度
CHUNK_OVERLAP=80
# 向量检索返回topK片段数量
RETRIEVE_TOP_K=3

# 通义千问兼容OpenAI的接口地址
# LangChain默认会访问OpenAI官方地址，需要手动指定base_url转发到阿里云通义千问网关
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 模型名称
MODEL_NAME=qwen-vl-max
EMBEDDING_MODEL_NAME=text-embedding-v1# 文本转向量模型（修正拼写texr → text）

# 请求超时时间设置
# 底层http库部分场景要求浮点类型，使用60.0避免潜在类型报错
REQUEST_TIMEOUT=60.0

# 温度参数，控制模型输出随机性
TEMPERATURE=0.7
# 取值区间0~1
# 越接近0：输出稳定、逻辑严谨，随机性低
# 越接近1：回答发散、创意更强，但更容易产生幻觉